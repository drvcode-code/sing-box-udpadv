new file mode 100644
index 000000000..53e2d82a6
--- /dev/null
+++ b/common/listener/listener_advertise.go
@@ -0,0 +1,38 @@
+package listener
+
+import (
+	"context"
+	"net"
+	"net/netip"
+
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+type PacketListener interface {
+	ListenPacket(listenConfig net.ListenConfig, ctx context.Context, network string, address string) (net.PacketConn, error)
+}
+
+// AdvertisedPacketListener reports Addr as the local IP of the sockets it opens,
+// so a SOCKS5 UDP ASSOCIATE reply carries a public address (e.g. an EIP behind
+// 1:1 NAT) instead of the private address the relay is actually bound to.
+type AdvertisedPacketListener struct {
+	PacketListener
+	Addr netip.Addr
+}
+
+func (l *AdvertisedPacketListener) ListenPacket(listenConfig net.ListenConfig, ctx context.Context, network string, address string) (net.PacketConn, error) {
+	conn, err := l.PacketListener.ListenPacket(listenConfig, ctx, network, address)
+	if err != nil {
+		return nil, err
+	}
+	return &advertisedPacketConn{conn, l.Addr}, nil
+}
+
+type advertisedPacketConn struct {
+	net.PacketConn
+	addr netip.Addr
+}
+
+func (c *advertisedPacketConn) LocalAddr() net.Addr {
+	return M.SocksaddrFrom(c.addr, M.SocksaddrFromNet(c.PacketConn.LocalAddr()).Port).UDPAddr()
+}
